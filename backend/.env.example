# Sundaram Prep Backend Environment Variables
PORT=5001
SECRET_KEY=sundaram-prep-super-secret-key-change-in-production
JWT_SECRET_KEY=sundaram-prep-jwt-secret-key-change-in-production

# Neon PostgreSQL Connection URL (e.g. postgresql://user:pass@ep-cool-xyz.us-east-2.aws.neon.tech/sundaram_prep?sslmode=require)
DATABASE_URL=

# OpenAI API Key (Never expose in frontend)
OPENAI_API_KEY=
OPENAI_REASONING_MODEL=o3-mini
OPENAI_FAST_MODEL=gpt-4o-mini

# Resend Email Integration
RESEND_API_KEY=
MAIL_FROM=Sundaram Prep <no-reply@sundaramprep.com>
FROM_EMAIL=Sundaram Prep <no-reply@sundaramprep.com>

# Security / Cookies
COOKIE_SECURE=false

# Allowed Frontend URL & CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://sundaram-prep.onrender.com

