# ================================================================
# SUNDARAM PREP - ENVIRONMENT CONFIGURATION EXAMPLE
# Tagline: Practice. Focus. Improve.
# ================================================================
# WARNING: NEVER commit actual secret keys or credentials to Git.
# Duplicate this file to .env (or backend/.env) and populate secrets.

# ----------------------------------------------------------------
# BACKEND SERVICES (Render Web Service / Flask + Gunicorn)
# ----------------------------------------------------------------
PORT=5001
SECRET_KEY=replace-with-a-random-64-character-hex-secret
JWT_SECRET_KEY=replace-with-a-random-64-character-jwt-secret

# Neon PostgreSQL Database URL
# Example: postgresql://sundaram_owner:secret@ep-cool-cloud-123456.us-east-2.aws.neon.tech/sundaram_prep?sslmode=require
DATABASE_URL=

# Google Gemini AI API Key (Primary Recommended AI Provider)
# Get a free key at https://aistudio.google.com/
# Keep backend-only. Never expose to React / Vite.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# OpenAI API Key (Optional secondary fallback)
# Keep backend-only. Never expose to React / Vite.
OPENAI_API_KEY=
OPENAI_REASONING_MODEL=o3-mini
OPENAI_FAST_MODEL=gpt-4o-mini

# Resend Email Integration (Transactional OTP Delivery)
# Keep backend-only. Never expose to React / Vite.
RESEND_API_KEY=
MAIL_FROM=Sundaram Prep <no-reply@sundaramprep.com>

# Web Push Notifications (VAPID Configuration)
# Generate VAPID keys with `npx web-push generate-vapid-keys` or pywebpush
VAPID_PUBLIC_KEY=BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkdtO_jlJzpRhTOmcjvmKeAhBpFiY6WuYwc9vpSoN2
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=admin@sundaramprep.com

# News API Configuration (Optional external feeds)
NEWS_API_KEY=

# Security & Session Settings
COOKIE_SECURE=true
COOKIE_SAMESITE=Lax
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5

# CORS & Frontend Origins
FRONTEND_URL=https://sundaram-prep.onrender.com
CORS_ORIGINS=https://sundaram-prep.onrender.com,http://localhost:5173

# ----------------------------------------------------------------
# FRONTEND (Vite / React Static Site)
# ----------------------------------------------------------------
# When deployed on Render Static Site, points to the live Backend Web Service:
# Example: https://sundaram-prep-api.onrender.com/api
VITE_API_BASE_URL=https://sundaram-prep-api.onrender.com/api
